{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/etc/nixos/assets/NixOS ascii",
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "constants": [
      "\u001b[34m\u001B[1m", // {$1}
      "\u001b[37m\u001B[1m" // {$2}


    ]
  },
  "modules": [
    {
      "type": "os",
      "key": "{$1}  Distro     ",
      "format": "{$2}{name} {version}"
    },
    {
      "type": "kernel",
      "key": "{$1}  Kernel     ",
      "format": "{$2}{sysname} {release}"
    },
    {
      "type": "wm",
      "key": "{$1}󰘔  WM         ",
      "format": "{$2}{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "{$1}  Terminal   ",
      "format": "{$2}{pretty-name} {version}"
    },
    {
      "type": "shell",
      "key": "{$1}󰞷  Shell      ",
      "format": "{$2}{pretty-name} {version}"
    },
    "break",
    {
      "type": "cpu",
      "key": "{$1}  CPU        ",
      "format": "{$2}{name} {freq-max}"
    },
    {
      "type": "gpu",
      "key": "{$1}  GPU        ",
      "format": "{$2}{name} {driver}"
    },
    {
      "type": "display",
      "key": "{$1}󰍹  Display    ",
      "format": "{$2}{width}x{height} {inch}\" {refresh-rate} Hz, {name}"
    },
    {
      "type": "memory",
      "key": "{$1}  Memory     ",
      "format": "{$2}{used} / {total} {percentage}"
    },
    {
      "type": "swap",
      "key": "{$1}󰯍  Swap       ",
      "format": "{$2}{used} / {total} {percentage}"
    },
    {
      "type": "disk",
      "key": "{$1}  Root       ",
      "folders": ["/"],
      "format": "{$2}{size-used} / {size-total} {size-percentage} {size-percentage-bar}"
    },
    {
      "type": "disk",
      "key": "{$1}  Storage    ",
      "folders": ["/mnt/storage"],
      "format": "{$2}{size-used} / {size-total} {size-percentage}"
    },
    "break",
    {
      "type": "disk",
      "key": "{$1}  OS Age     ",
      "folders": "/",
      "format": "{$2}{days} day(s)"
    },
    {
      "type": "uptime",
      "key": "{$1}  Uptime     ",
      "format": "{$2}{hours} hours, {minutes} mins"
    },
    "break",
    {
      "type": "colors",
      "key": "{$1}              ",
      "symbol": "circle"
    }
  ]
}
