--!nonstrict
local browser = (function()
    --[[
    Search uses Invidious and thumbnails use its approved wsrv.nl proxy.
    Playback keeps the shared mpv profile and streams directly from YouTube/Googlevideo.
    ]]
    local M = {}
    local DEFAULT_INSTANCE = "https://yt.chocolatemoo53.com"
    local INSTANCE = noctalia.getConfig("instance_url")
    local REGION = noctalia.getConfig("region")
    INSTANCE = type(INSTANCE) == "string" and INSTANCE:match("^%s*(.-)%s*$"):gsub("/+$", "") or ""
    -- Accept an HTTP(S) origin, optionally with a port, without credentials or paths.
    local authority = INSTANCE:match("^https?://([^/]+)$")
    local host = authority and (authority:match("^([A-Za-z0-9.-]+):%d+$")
        or authority:match("^([A-Za-z0-9.-]+)$"))
    if not host or not host:match("^[A-Za-z0-9]") or not host:match("[A-Za-z0-9]$") then
        noctalia.notifyError("Invalid Invidious server URL; using the default server")
        INSTANCE = DEFAULT_INSTANCE
    end
    REGION = type(REGION) == "string" and REGION:match("^%s*(.-)%s*$"):upper() or ""
    if not REGION:match("^[A-Z][A-Z]$") then
        noctalia.notifyError("Search region must be a two-letter country code; using US")
        REGION = "US"
    end
    local QUALITY = noctalia.getConfig("playback_quality")
    if QUALITY ~= "auto" and QUALITY ~= "2160" and QUALITY ~= "1440"
        and QUALITY ~= "1080" and QUALITY ~= "720"
        and QUALITY ~= "480" and QUALITY ~= "audio" then
        noctalia.notifyError("Invalid playback quality; using Auto")
        QUALITY = "auto"
    end
    local generation, currentQuery = 0, ""
    local currentPage = nil
    local routes, allowed, downloading = {}, {}, {}
    local channelSearchInputs = {}
    local thumbnailQueue, queueIndex, activeDownloads = {}, 1, 0
    local cacheGeneration = 0
    --[[
    Noctalia shares eight HTTP slots between searches and image downloads.
    Three image workers leave capacity for normal searches and channel navigation.
    ]]
    local MAX_DOWNLOADS = 3
    -- Reuse pages for back navigation, but let long-running sessions see new uploads.
    local PAGE_TTL_MS = 60000
    local MAX_IMAGE_BYTES = 1024 * 1024
    local dataDir = noctalia.pluginDataDir()
    local resumeDir = dataDir and (dataDir .. "/resume") or nil
    local cacheDir = dataDir and (dataDir .. "/thumbnails") or nil
    if cacheDir and not noctalia.mkdirAll(cacheDir) then cacheDir = nil end

    local function clean(value)
        return type(value) == "string" and value:gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
    end
    local function validId(id, channel)
        return type(id) == "string" and #id == (channel and 24 or 11)
            and (not channel or id:sub(1, 2) == "UC") and id:match("^[A-Za-z0-9_-]+$") ~= nil
    end
    local function copyUrl(url)
        if noctalia.copyToClipboard(url, "text/plain") then
            noctalia.notify("URL copied")
        else
            noctalia.notifyError("Could not copy URL")
        end
    end
    local function copyUrlAction()
        return {id = "copy-url", title = "Copy URL", glyph = "copy"}
    end
    local function clearThumbnailCache()
        cacheGeneration = cacheGeneration + 1
        thumbnailQueue, queueIndex = {}, 1
        if not cacheDir then noctalia.notifyError("Thumbnail cache is unavailable"); return end
        local names = noctalia.listDir(cacheDir)
        if not names then noctalia.notifyError("Could not read thumbnail cache"); return end
        local failed = false
        for _, name in ipairs(names) do
            -- Only delete files generated by this plugin, including unfinished writes.
            local base = name:gsub("%.part$", "")
            local video = base:match("^video%-([A-Za-z0-9_-]+)%.jpg$")
            local channel = base:match("^channel%-([A-Za-z0-9_-]+)%.jpg$")
            if validId(video, false) or validId(channel, true) then
                if not noctalia.removeFile(cacheDir .. "/" .. name) then failed = true end
            end
        end
        if failed then noctalia.notifyError("Could not remove some cached thumbnails")
        else noctalia.notify("Thumbnail cache cleared") end
    end
    local function duration(seconds)
        if type(seconds) ~= "number" or seconds < 0 then return nil end
        seconds = math.floor(seconds)
        if seconds >= 3600 then
            return string.format("%d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
        end
        return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
    end
    local libraryPath = dataDir and (dataDir .. "/library.json") or nil
    local library = {version = 1, later = {}, history = {}, favorites = {}, channelPlays = {}}
    local libraryError = nil
    local LIST_PAGE_SIZE, HISTORY_LIMIT = 25, 500
    local function validRecords(records, channel)
        if type(records) ~= "table" then return false end
        local seen, count = {}, 0
        for index, item in pairs(records) do
            if type(index) ~= "number" or index < 1 or index > #records or index % 1 ~= 0 or type(item) ~= "table"
                or not validId(item.id, channel) or type(item.title) ~= "string"
                or (item.channelId ~= nil and not validId(item.channelId, true))
                or type(item.subtitle) ~= "string" or seen[item.id] then return false end
            seen[item.id], count = true, count + 1
        end
        return count == #records
    end
    local function validPlays(plays)
        if type(plays) ~= "table" then return false end
        for id, count in pairs(plays) do
            if not validId(id, true) or type(count) ~= "number" or count < 0
                or count >= math.huge or count % 1 ~= 0 then return false end
        end
        return true
    end
    local function validQueueEvents(events)
        if type(events) ~= "table" then return false end
        for id, token in pairs(events) do
            if not validId(id, false) or type(token) ~= "string" then return false end
        end
        return true
    end
    if libraryPath and noctalia.fileExists(libraryPath) then
        local body = noctalia.readFile(libraryPath)
        local ok, saved = pcall(noctalia.json.decode, body or "")
        if ok and type(saved) == "table" and saved.version == 1
            and validRecords(saved.later) and validRecords(saved.history)
            and (saved.favorites == nil or validRecords(saved.favorites, true))
            and (saved.channelPlays == nil or validPlays(saved.channelPlays))
            and (saved.queueEvents == nil or validQueueEvents(saved.queueEvents)) then
            -- Existing libraries acquire favorites without rewriting their video records.
            saved.favorites = saved.favorites or {}
            saved.channelPlays = saved.channelPlays or {}
            library = saved
        else
            -- Preserve unreadable or incompatible data instead of overwriting it.
            libraryError = "Could not read the YouTube library; existing data was preserved"
        end
    end
    local function saveLibrary(later, history, favorites, channelPlays, queueEvents)
        if libraryError then noctalia.notifyError(libraryError); return false end
        if not libraryPath or not noctalia.mkdirAll(dataDir) then
            noctalia.notifyError("YouTube library storage is unavailable"); return false
        end
        local updated = {version = 1, later = later, history = history, favorites = favorites or library.favorites,
            channelPlays = channelPlays or library.channelPlays,
            queueEvents = queueEvents or library.queueEvents or {}}
        local ok, body = pcall(noctalia.json.encode, updated)
        local temporary = libraryPath .. ".part"
        if ok and type(body) == "string" and noctalia.writeFile(temporary, body)
            and noctalia.renameFile(temporary, libraryPath) then
            library = updated
            return true
        end
        noctalia.removeFile(temporary)
        noctalia.notifyError("Could not save the YouTube library")
        return false
    end
    local function contains(records, id)
        for _, item in ipairs(records) do if item.id == id then return true end end
        return false
    end
    local function displayTitle(item)
        local saved = item.destination and contains(library.favorites, item.destination.id)
            or contains(library.later, item.id)
        return saved and ("☆ " .. item.title) or item.title
    end
    local function without(records, id)
        local result = {}
        for _, item in ipairs(records) do if item.id ~= id then table.insert(result, item) end end
        return result
    end
    local function record(item)
        return {id = item.id, title = item.title, subtitle = item.subtitle, channelId = item.channelId}
    end
    local queueItems, queueError = {}, nil
    local function enrichRecord(item)
        local result = record(item)
        local function genericTitle(title)
            return title == "" or title == result.id or title == "YouTube · " .. result.id or title == "Untitled video"
        end
        local function genericSubtitle(subtitle)
            return subtitle == "" or subtitle == "Video" or subtitle == "Added from URL"
        end
        for _, records in ipairs({library.history, library.later, queueItems}) do
            for _, known in ipairs(records) do
                if known.id == result.id then
                    if genericTitle(result.title) and not genericTitle(known.title) then result.title = known.title end
                    if genericSubtitle(result.subtitle) and not genericSubtitle(known.subtitle) then
                        result.subtitle = known.subtitle
                    end
                    result.channelId = result.channelId or known.channelId
                end
            end
        end
        return result
    end
    local function queueText(key) return noctalia.tr("queue." .. key) end
    local queuePath = dataDir and (dataDir .. "/queue.json") or nil
    if queuePath and noctalia.fileExists(queuePath) then
        local ok, saved = pcall(noctalia.json.decode, noctalia.readFile(queuePath) or "")
        if ok and type(saved) == "table" and saved.version == 1 and validRecords(saved.items) then
            queueItems = saved.items
        else queueError = queueText("read_error") end
    end
    local function saveQueue(items)
        if queueError then noctalia.notifyError(queueError); return false end
        if not queuePath or not noctalia.mkdirAll(dataDir) then
            noctalia.notifyError(queueText("storage_error")); return false
        end
        local ok, body = pcall(noctalia.json.encode, {version = 1, items = items})
        local temporary = queuePath .. ".part"
        if ok and type(body) == "string" and noctalia.writeFile(temporary, body)
            and noctalia.renameFile(temporary, queuePath) then
            queueItems = items
            return true
        end
        noctalia.removeFile(temporary)
        noctalia.notifyError(queueText("save_error"))
        return false
    end
    local function resetQueue()
        if not queueError or not queuePath then return false end
        local body = noctalia.readFile(queuePath)
        if type(body) ~= "string" then noctalia.notifyError(queueText("backup_error")); return false end
        local base = queuePath .. ".backup-" .. tostring(noctalia.nowMs())
        local backup, suffix = base, 0
        while noctalia.fileExists(backup) do
            suffix = suffix + 1
            backup = base .. "-" .. suffix
        end
        local temporary = backup .. ".part"
        if not noctalia.writeFile(temporary, body) or not noctalia.renameFile(temporary, backup) then
            noctalia.removeFile(temporary)
            noctalia.notifyError(queueText("backup_error")); return false
        end
        local previousError = queueError
        queueError = nil
        if not saveQueue({}) then queueError = previousError; return false end
        noctalia.notify(queueText("reset_done"), backup)
        return true
    end
    local function playbackArgs()
        local args = {"mpv", "--profile=youtube"}
        if QUALITY == "audio" then
            table.insert(args, "--ytdl-format=ba[protocol^=m3u8]/ba/b")
            table.insert(args, "--vid=no")
            -- Audio playback needs an explicit window when launched outside a terminal.
            table.insert(args, "--force-window=yes")
        elseif QUALITY ~= "auto" then
            -- Keep the profile's HLS preference while enforcing the height cap on every fallback.
            local cap = "[height<=" .. QUALITY .. "]"
            table.insert(args, "--ytdl-format=bv[protocol^=m3u8]" .. cap
                .. "+ba[protocol^=m3u8]/b[protocol^=m3u8]" .. cap .. "/bv*" .. cap .. "+ba/b" .. cap)
        end
        return args
    end
    local function runQueue(action, startId, startPosition)
        local pluginDir = noctalia.pluginDir()
        if not pluginDir or not queuePath or not noctalia.commandExists("python3") then
            noctalia.notifyError(queueText("helper_unavailable")); return false
        end
        local args = {"python3", pluginDir .. "/queue-player.py", action, queuePath}
        if action == "play" then
            if startId then table.insert(args, "--queue-start=" .. startId) end
            if startPosition then table.insert(args, "--queue-start-time=" .. tostring(startPosition)) end
            local options = playbackArgs()
            for i = 2, #options do table.insert(args, options[i]) end
            table.insert(args, "--script-opts-append=youtube-resume-record_dir=" .. resumeDir)
            table.insert(args, "--script-opts-append=youtube-resume-queue_events=" .. dataDir .. "/queue-events")
        end
        local started = noctalia.runAsync(args, function(result)
            if result.exitCode ~= 0 then
                noctalia.notifyError(queueText(action == "play" and "play_error" or "sync_error"),
                    clean(result.stderr):sub(1, 240))
            end
        end, 15000)
        if not started then noctalia.notifyError(queueText("helper_unavailable")) end
        return started
    end
    local function toggleQueue(item)
        local items = without(queueItems, item.id)
        if not contains(queueItems, item.id) then table.insert(items, enrichRecord(item)) end
        if saveQueue(items) then runQueue("sync") end
    end
    local function playbackProgress(id)
        if not resumeDir or not validId(id, false) then return nil end
        local path = resumeDir .. "/" .. id .. ".json"
        if not noctalia.fileExists(path) then return nil end
        local ok, saved = pcall(noctalia.json.decode, noctalia.readFile(path) or "")
        if ok and type(saved) == "table" and saved.id == id and type(saved.position) == "number"
            and saved.position >= 0 and saved.position < math.huge and type(saved.length) == "number"
            and saved.length >= 0 and saved.length < math.huge then
            return duration(saved.position) .. (saved.length > 0 and (" / " .. duration(saved.length)
                .. " · " .. math.min(100, math.floor(saved.position / saved.length * 100)) .. "%") or "")
        end
        return nil
    end
    local function historyVideos()
        local records = {}
        for _, known in ipairs(library.history) do
            local item = record(known)
            item.progress = playbackProgress(item.id)
            table.insert(records, item)
        end
        return records
    end
    local function sortedFavorites()
        local favorites = {}
        for _, item in ipairs(library.favorites) do table.insert(favorites, item) end
        table.sort(favorites, function(a, b)
            local ac, bc = library.channelPlays[a.id] or 0, library.channelPlays[b.id] or 0
            if ac ~= bc then return ac > bc end
            if a.title ~= b.title then return a.title < b.title end
            return a.id < b.id
        end)
        return favorites
    end
    local function toggleLater(item)
        local later = without(library.later, item.id)
        if not contains(library.later, item.id) then table.insert(later, 1, enrichRecord(item)) end
        return saveLibrary(later, library.history)
    end
    local function startTime(url)
        local value = url:match("[?&#]t=([^&#]+)") or url:match("[?&#]start=([^&#]+)")
        if not value then return nil end
        if value:match("^%d+$") then return tonumber(value) end
        local hours, minutes, seconds = value:match("^(%d+)h(%d+)m(%d+)s$")
        if hours then return tonumber(hours) * 3600 + tonumber(minutes) * 60 + tonumber(seconds) end
        hours, minutes = value:match("^(%d+)h(%d+)m$")
        if hours then return tonumber(hours) * 3600 + tonumber(minutes) * 60 end
        hours, seconds = value:match("^(%d+)h(%d+)s$")
        if hours then return tonumber(hours) * 3600 + tonumber(seconds) end
        minutes, seconds = value:match("^(%d+)m(%d+)s$")
        if minutes then return tonumber(minutes) * 60 + tonumber(seconds) end
        hours = value:match("^(%d+)h$")
        if hours then return tonumber(hours) * 3600 end
        minutes = value:match("^(%d+)m$")
        if minutes then return tonumber(minutes) * 60 end
        seconds = value:match("^(%d+)s$")
        return seconds and tonumber(seconds) or nil
    end
    local function rememberPlayed(item, eventToken)
        if not item then return end
        if eventToken and library.queueEvents and library.queueEvents[item.id] == eventToken then return true end
        local history = without(library.history, item.id)
        table.insert(history, 1, record(item))
        while #history > HISTORY_LIMIT do table.remove(history) end
        local plays = {}
        for id, count in pairs(library.channelPlays) do plays[id] = count end
        if item.channelId then plays[item.channelId] = (plays[item.channelId] or 0) + 1 end
        local later = {}
        for _, known in ipairs(library.later) do
            table.insert(later, known.id == item.id and record(item) or known)
        end
        local events = {}
        for id, token in pairs(library.queueEvents or {}) do events[id] = token end
        if eventToken then events[item.id] = eventToken end
        -- Keep receipts only for retained history entries so they cannot grow without bound.
        for id in pairs(events) do if not contains(history, id) then events[id] = nil end end
        return saveLibrary(later, history, nil, plays, events)
    end
    function M.collectQueueEvents()
        if not dataDir or libraryError then return end
        local dir = dataDir .. "/queue-events"
        if not noctalia.fileExists(dir) then return end
        local names = noctalia.listDir(dir) or {}
        table.sort(names)
        for _, name in ipairs(names) do
            if name:match("^%d+%.%d+%.%d+%.json$") then
                local path = dir .. "/" .. name
                local ok, event = pcall(noctalia.json.decode, noctalia.readFile(path) or "")
                if ok and type(event) == "table" and validId(event.id, false) then
                    local item = {id = event.id, title = "YouTube · " .. event.id, subtitle = "Added from URL"}
                    for _, queued in ipairs(queueItems) do if queued.id == event.id then item = queued; break end end
                    if rememberPlayed(enrichRecord(item), name) then noctalia.removeFile(path) end
                end
            end
        end
    end
    local function play(item, url)
        if not noctalia.commandExists("mpv") then noctalia.notifyError("mpv is not installed"); return end
        if item then item = enrichRecord(item) end
        if item then
            local items, found, changed = {}, false, false
            for _, queued in ipairs(queueItems) do
                if queued.id == item.id then
                    found = true
                    changed = queued.title ~= item.title or queued.subtitle ~= item.subtitle
                        or queued.channelId ~= item.channelId
                    table.insert(items, record(item))
                else table.insert(items, queued) end
            end
            if not found then table.insert(items, 1, record(item)); changed = true end
            if changed and not saveQueue(items) then return end
            local start = startTime(url)
            runQueue("play", item.id, start and start < math.huge and start or nil)
            return
        end
        local args = playbackArgs()
        table.insert(args, "--")
        table.insert(args, url)
        if not noctalia.runAsync(args) then
            noctalia.notifyError("Could not start mpv"); return
        end
    end
    local function route(page)
        if not page.label then
            local label = page.kind == "video" and ("Video · " .. page.item.title .. " · " .. page.item.id)
                or page.kind == "later" and ("Watch later · Page " .. page.number)
                or page.kind == "history" and ("Watch history · Page " .. page.number)
                or page.kind == "favorites" and ("Favorite channels · Page " .. page.number)
                or page.kind == "feed" and ("Latest from favorites · Page " .. page.number)
                or page.kind == "clear" and "Confirm clear history"
                or page.kind == "clear-cache" and "Confirm clear thumbnail cache"
                or page.kind == "queue" and ("Playback queue · Page " .. page.number)
                or page.kind == "clear-queue" and "Confirm clear playback queue"
                or page.kind == "reset-queue" and "Confirm reset playback queue"
                or page.kind == "channel-search-input" and (page.name .. " · Search in channel:")
                or page.kind == "channel-search" and (page.name .. " · Search · " .. page.text .. " · Page " .. page.number)
                or page.kind == "channel" and (page.name .. " · Videos · Page " .. page.number)
                or (page.number == 1 and page.text or (page.text .. " · Search page " .. page.number))
            local base, suffix = label, 1
            while routes[label] and routes[label] ~= page do
                suffix = suffix + 1
                label = base .. " (" .. suffix .. ")"
            end
            page.label, routes[label] = label, page
        end
        -- Noctalia prepends the provider prefix to result.query itself.
        return "Search " .. page.label
    end
    local function navigation(title, page, glyph)
        return {id = "navigation:" .. title, title = title, glyph = glyph or "arrow-left", query = route(page)}
    end
    local function videoRoute(item, page)
        page.details = page.details or {}
        local detail = page.details[item.id] or {kind = "video", origin = page}
        detail.item, page.details[item.id] = item, detail
        return route(detail)
    end
    local function favoriteAction(page)
        return {id = "toggle-channel", title = contains(library.favorites, page.id)
            and "Remove from favorite channels" or "Add to favorite channels", glyph = "star"}
    end
    local function channelSearchAction(page)
        page.searchInput = page.searchInput or {kind = "channel-search-input", id = page.id,
            name = page.name, origin = page, searches = {}}
        local query = route(page.searchInput)
        channelSearchInputs[page.searchInput.label] = page.searchInput
        return {id = "search-channel", title = "Search in channel", subtitle = page.name,
            glyph = "search", query = query .. " "}
    end
    --[[
    This instance redirects images to wsrv.nl. Address that approved proxy directly
    instead of allowing arbitrary redirects that could connect this device to Google.
    ]]
    local function proxyImage(url)
        return "https://wsrv.nl/?url=" .. noctalia.string.urlEncode(url) .. "&maxage=300&output=jpg"
    end
    local function avatarUrl(thumbnails)
        if type(thumbnails) ~= "table" then return nil end
        for _, image in ipairs(thumbnails) do
            local url = type(image) == "table" and image.url or nil
            if type(url) == "string" then
                local prefix = INSTANCE .. "/ggpht/"
                local path = url:sub(1, #prefix) == prefix and url:sub(#prefix + 1)
                    or url:match("^/ggpht/(.+)$")
                if not path then
                    path = url:match("^https?://yt3%.ggpht%.com/(.+)$")
                        or url:match("^//yt3%.ggpht%.com/(.+)$")
                end
                if path and path ~= "" then return proxyImage("https://yt3.ggpht.com/" .. path) end
                path = url:match("^https?://yt3%.googleusercontent%.com/(.+)$")
                    or url:match("^//yt3%.googleusercontent%.com/(.+)$")
                if path then return proxyImage("https://yt3.googleusercontent.com/" .. path) end
            end
        end
        return nil
    end
    local function normalize(source, page)
        local items, seen = {}, {}
        for _, item in ipairs(source) do
            if type(item) == "table" then
                if item.type == "channel" and validId(item.authorId, true) then
                    local key = "channel-" .. item.authorId
                    if not seen[key] then
                        seen[key] = true
                        local name = clean(item.author)
                        if name == "" then name = item.authorId end
                        table.insert(items, {
                            key = key, title = name, subtitle = "Channel · Browse videos", glyph = "user-circle",
                            image = avatarUrl(item.authorThumbnails),
                            destination = {kind = "channel", id = item.authorId, name = name, number = 1, origin = page},
                        })
                    end
                elseif validId(item.videoId, false) then
                    local key = "video-" .. item.videoId
                    if not seen[key] then
                        seen[key] = true
                        local details, title = {"Video"}, clean(item.title)
                        local author, length = clean(item.author), duration(item.lengthSeconds)
                        if author ~= "" then table.insert(details, author) end
                        if length then table.insert(details, length) end
                        if item.liveNow then table.insert(details, "LIVE") end
                        table.insert(items, {
                            key = key, id = item.videoId, title = title ~= "" and title or "Untitled video",
                            channelId = validId(item.authorId, true) and item.authorId
                                or ((page.kind == "channel" or page.kind == "channel-search") and page.id or nil),
                            subtitle = table.concat(details, " · "), glyph = "player-play",
                            image = proxyImage("https://img.youtube.com/vi/" .. item.videoId .. "/hqdefault.jpg"),
                        })
                    end
                end
            end
        end
        return items
    end
    local function render()
        local page = currentPage
        if not page then return end
        local rows = {}
        allowed = {}
        if page.kind == "channel" then
            table.insert(rows, favoriteAction(page))
            table.insert(rows, copyUrlAction())
            table.insert(rows, channelSearchAction(page))
        end
        if page.groups then
            page.items = {}
            for _, group in ipairs(page.groups) do
                table.insert(page.items, {key = "channel-" .. group.channel.id, title = group.channel.title,
                    subtitle = "Channel", glyph = "user-circle", destination = group.destination})
                if group.error or not group.items or #group.items == 0 then
                    table.insert(page.items, {key = "feed-status-" .. group.channel.id,
                        title = group.channel.title .. " · " .. (group.error or (group.items and "No videos" or "Loading…")),
