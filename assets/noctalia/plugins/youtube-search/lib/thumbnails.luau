--!nonstrict
local records = require("./records.luau")
local Module = {}

function Module.new(dataDir, getPage, onChanged)
    local M = {}
    local validId = records.validId
    local downloading = {}
    local thumbnailQueue, queueIndex, activeDownloads = {}, 1, 0
    local cacheGeneration = 0
    -- Leave HTTP slots available for search and channel requests.
    local MAX_DOWNLOADS, MAX_IMAGE_BYTES = 3, 1024 * 1024
    local cacheDir = dataDir and (dataDir .. "/thumbnails") or nil
    if cacheDir and not noctalia.mkdirAll(cacheDir) then cacheDir = nil end
    local function clearThumbnailCache()
        cacheGeneration = cacheGeneration + 1
        thumbnailQueue, queueIndex = {}, 1
        if not cacheDir then noctalia.notifyError("Thumbnail cache is unavailable"); return end
        local names = noctalia.listDir(cacheDir)
        if not names then noctalia.notifyError("Could not read thumbnail cache"); return end
        local failed = false
        for _, name in ipairs(names) do
            -- Only delete files generated by this plugin, including unfinished writes.
            local base = name:gsub("%.part$", "")
            local video = base:match("^video%-([A-Za-z0-9_-]+)%.jpg$")
            local channel = base:match("^channel%-([A-Za-z0-9_-]+)%.jpg$")
            if validId(video, false) or validId(channel, true) then
                if not noctalia.removeFile(cacheDir .. "/" .. name) then failed = true end
            end
        end
        if failed then noctalia.notifyError("Could not remove some cached thumbnails")
        else noctalia.notify("Thumbnail cache cleared") end
    end
    local function saveThumbnail(path, response)
        local body = response.body
        if not response.ok or response.status ~= 200 or type(body) ~= "string"
            or #body < 12 or #body > MAX_IMAGE_BYTES then return false end
        local jpeg = body:sub(1, 3) == string.char(255, 216, 255)
        local png = body:sub(1, 8) == "\137PNG\r\n\26\n"
        local webp = body:sub(1, 4) == "RIFF" and body:sub(9, 12) == "WEBP"
        if not jpeg and not png and not webp then return false end
        local temporary = path .. ".part"
        if noctalia.writeFile(temporary, body) and noctalia.renameFile(temporary, path) then return true end
        noctalia.removeFile(temporary)
        return false
    end
    local pumpThumbnails, requestThumbnails
    pumpThumbnails = function()
        while activeDownloads < MAX_DOWNLOADS and queueIndex <= #thumbnailQueue do
            local job = thumbnailQueue[queueIndex]
            queueIndex = queueIndex + 1
            if not noctalia.fileExists(job.path) and not downloading[job.key] then
                downloading[job.key] = true
                activeDownloads = activeDownloads + 1
                -- Keep redirects disabled even on the approved image proxy.
                local started = noctalia.http({url = job.url, follow_redirects = false}, function(response)
                    downloading[job.key] = nil
                    activeDownloads = activeDownloads - 1
                    local ok = job.cacheGeneration == cacheGeneration and saveThumbnail(job.path, response)
                    if ok and getPage() and getPage().items then onChanged() end
                    if job.cacheGeneration ~= cacheGeneration and getPage() and getPage().items then
                        requestThumbnails()
                    else pumpThumbnails() end
                end)
                if not started then
                    downloading[job.key] = nil
                    activeDownloads = activeDownloads - 1
                    -- Keep rejected work queued until an accepted download frees a slot.
                    queueIndex = queueIndex - 1
                    break
                end
            end
        end
    end
    requestThumbnails = function()
        thumbnailQueue, queueIndex = {}, 1
        if not cacheDir or not getPage() then return end
        for _, item in ipairs(getPage().items or {}) do
            local path = cacheDir .. "/" .. item.key .. ".jpg"
            if item.image and not noctalia.fileExists(path) and not downloading[item.key] then
                table.insert(thumbnailQueue, {key = item.key, url = item.image, path = path,
                    cacheGeneration = cacheGeneration})
            end
        end
        pumpThumbnails()
    end

    M.clear, M.pump, M.request = clearThumbnailCache, pumpThumbnails, requestThumbnails
    function M.cancel() thumbnailQueue, queueIndex = {}, 1 end
    function M.path(key) return cacheDir and (cacheDir .. "/" .. key .. ".jpg") or nil end
    return M
end

return Module
